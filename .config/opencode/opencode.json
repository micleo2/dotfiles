{
  "$schema": "https://opencode.ai/config.json",
  "tools": {
    "websearch": true
  },
  "provider": {
    "ninfer": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NInfer (local)",
      "options": {
        "baseURL": "http://10.0.20.2:8090/v1"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B (NVFP4, local)",
          "modalities": {
            "input": ["text", "image"]
          },
          "variant": "low",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    }
  }
}
