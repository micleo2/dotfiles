#!/usr/bin/env python3
"""Pick an ssh host in the retro launcher and open it in kitty's ssh kitten.

Hosts: $XDG_STATE_HOME/quickshell/retro/ssh-hosts, one target per line. A
trailing `tmux` token attaches to (or creates) a tmux session named after
the host instead of landing in a plain login shell.
"""

import argparse
import os
import re
import shlex
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

HEADER = """\
# ssh hosts for retro-ssh (SUPER+U, s). One target per line, split like a
# shell command line: `host`, `user@host`, `-p 2222 user@host`. A trailing
# `tmux` token (`user@host tmux`) attaches to, or creates, a tmux session on
# the host named after it (`host`, minus any `.local`).
"""

TMUX_MARKER = "tmux"


@dataclass(frozen=True)
class Host:
    label: str
    args: list[str]


def tmux_session_name(target: list[str]) -> str:
    host = [t for t in target if not t.startswith("-")][-1]
    return host.rpartition("@")[2].removesuffix(".local")


def parse_host(line: str) -> Host:
    args = shlex.split(line)
    if args[-1] != TMUX_MARKER:
        return Host(line, args)
    target = args[:-1]
    # ssh only allocates a pty for a login session; a remote command needs
    # -t or tmux dies with "open terminal failed: not a terminal". The kitten
    # passes -t through and still installs terminfo + shell integration first.
    session = tmux_session_name(target)
    return Host(line, ["-t", *target, "tmux", "new", "-A", "-s", session])


def state_dir() -> Path:
    base = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    path = Path(base) / "quickshell" / "retro"
    path.mkdir(parents=True, exist_ok=True)
    return path


def seed_from_known_hosts() -> list[str]:
    path = Path.home() / ".ssh" / "known_hosts"
    if not path.is_file():
        return []
    seen: list[str] = []
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line[0] in "#|":
            continue
        for name in line.split()[0].split(","):
            if name.startswith("@"):
                continue
            port = ""
            match = re.fullmatch(r"\[(.+)\]:(\d+)", name)
            if match:
                name, port = match.groups()
            if not re.search(r"[A-Za-z]", name) or name == "github.com":
                continue
            target = f"-p {port} {name}" if port else name
            if target not in seen:
                seen.append(target)
    return seen


def load_hosts(path: Path) -> list[Host]:
    if not path.exists():
        path.write_text(HEADER + "".join(f"{host}\n" for host in seed_from_known_hosts()))
    hosts: list[Host] = []
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        try:
            hosts.append(parse_host(line))
        except (ValueError, IndexError) as error:
            print(f"retro-ssh: bad line in {path}: {line!r}: {error}", file=sys.stderr)
    return hosts


def pick(hosts: list[Host]) -> Host | None:
    result = subprocess.run(
        ["retro-launcher", "-p", "ssh"],
        input="".join(f"{host.label}\n" for host in hosts),
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return None
    label = result.stdout.strip()
    return next((host for host in hosts if host.label == label), None)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="retro-ssh",
        description="Pick an ssh host in the retro launcher and open it in kitty's ssh kitten.",
    )
    parser.add_argument(
        "--print", action="store_true", help="print the kitten args for the pick instead of running it"
    )
    options = parser.parse_args()

    host = pick(load_hosts(state_dir() / "ssh-hosts"))
    if host is None:
        return 1
    if options.print:
        print(shlex.join(["kitty", "kitten", "ssh", *host.args]))
        return 0
    # `kitty +kitten ssh` runs in the current terminal; this opens a window.
    os.execvp("kitty", ["kitty", "kitten", "ssh", *host.args])


if __name__ == "__main__":
    sys.exit(main())
