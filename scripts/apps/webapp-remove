#!/usr/bin/env python3
"""Remove a web app desktop launcher (and its icon).

Usage: webapp-remove [--dry] [--list] [name...]
Remove a web app desktop launcher (and its icon).
Prints the removed file paths to stdout.
With no name, lists all installed web apps and picks one interactively.
  --dry    Print the files that would be removed, without removing them.
  --list   List all installed web apps and exit.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys

ICON_DIR = os.path.expanduser("~/.local/share/icons/hicolor/256x256/apps")
OLD_ICON_DIR = os.path.expanduser("~/.local/share/applications/icons")
DESKTOP_DIR = os.path.expanduser("~/.local/share/applications")


def safe_name(name: str) -> str:
    return re.sub(r"^-+|-+$", "", re.sub(r"[^a-z0-9]+", "-", name.lower()))


def die(msg: str) -> None:
    print(msg)
    sys.exit(1)


def find_webapps() -> list[str]:
    """Find all web apps (the webapp-launch marker in Exec is what identifies ours)."""
    names = []
    for entry in os.listdir(DESKTOP_DIR):
        if not entry.endswith(".desktop"):
            continue
        path = os.path.join(DESKTOP_DIR, entry)
        try:
            with open(path, errors="replace") as f:
                for line in f:
                    if line.startswith("Exec=") and ("webapp-launch" in line or "webapp-handler" in line):
                        names.append(entry[: -len(".desktop")])
                        break
        except OSError:
            continue
    return sorted(names)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="webapp-remove",
        description="Remove a web app desktop launcher (and its icon).",
    )
    parser.add_argument("--dry", action="store_true", help="print the files that would be removed, without removing them")
    parser.add_argument("--list", action="store_true", help="list all installed web apps and exit")
    parser.add_argument("name", nargs="*", help="web app name (space-separated); omit to pick interactively")
    args = parser.parse_args()

    web_apps = find_webapps()

    if args.list:
        if web_apps:
            print("\n".join(web_apps))
        else:
            print("No web apps installed.")
        return 0

    if not args.name:
        if web_apps:
            if shutil.which("rofi"):
                result = subprocess.run(
                    ["rofi", "-dmenu", "-prompt", "Select web app to remove"],
                    input="\n".join(web_apps) + "\n",
                    capture_output=True,
                    text=True,
                )
                app_name = result.stdout.strip()
            elif shutil.which("gum"):
                result = subprocess.run(
                    ["gum", "choose", *web_apps, "--header", "Select web app to remove"],
                    capture_output=True,
                    text=True,
                )
                app_name = result.stdout.strip()
            else:
                print("No interactive picker found (need rofi or gum). Web apps:")
                print("\n".join(web_apps))
                return 1
        else:
            print("No web apps to remove.")
            return 1
    else:
        app_name = " ".join(args.name)

    if not app_name:
        die("You must select a web app to remove.")

    icon_name = safe_name(app_name)
    files = [
        f"{DESKTOP_DIR}/{app_name}.desktop",
        f"{ICON_DIR}/{icon_name}.png",
        f"{ICON_DIR}/{app_name}.png",
        f"{OLD_ICON_DIR}/{app_name}.png",
    ]
    existing = [f for f in files if os.path.lexists(f)]

    if not existing:
        print(f"Nothing to remove for {app_name}.")
        return 1

    if args.dry:
        for f in existing:
            print(f"Would remove: {f}")
        return 0

    for f in existing:
        os.remove(f)
        print(f"Removing: {f}")
    subprocess.run(
        ["update-desktop-database", DESKTOP_DIR],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())