#!/bin/bash

# Remove a web app desktop launcher (and its icon).
# Usage: webapp-remove [name] | webapp-remove --list
# With no argument, lists all installed web apps and picks one interactively.

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: webapp-remove [--dry] [name] | webapp-remove --list"
  echo "Remove a web app desktop launcher (and its icon)."
  echo "Prints the removed file paths to stdout."
  echo "With no argument, lists all installed web apps and picks one interactively."
  echo "  --dry    Print the files that would be removed, without removing them."
  echo "  --list   List all installed web apps and exit."
  exit 0
fi

set -e

DRY=false
if [[ ${1:-} == "--dry" ]]; then
  DRY=true
  shift
fi

ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
OLD_ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_DIR="$HOME/.local/share/applications"

# Find all web apps (the webapp-launch marker in Exec is what identifies ours)
WEB_APPS=()
while IFS= read -r -d '' file; do
  if grep -q '^Exec=.*\(webapp-launch\|webapp-handler\).*' "$file"; then
    WEB_APPS+=("$(basename "${file%.desktop}")")
  fi
done < <(find "$DESKTOP_DIR" -name '*.desktop' -print0)

SORTED_WEB_APPS=()
if ((${#WEB_APPS[@]})); then
  mapfile -t SORTED_WEB_APPS < <(printf '%s\n' "${WEB_APPS[@]}" | sort)
fi

if [[ ${1:-} == "--list" ]]; then
  if ((${#SORTED_WEB_APPS[@]})); then
    printf '%s\n' "${SORTED_WEB_APPS[@]}"
  else
    echo "No web apps installed."
  fi
  exit 0
fi

if (( $# == 0 )); then
  if ((${#SORTED_WEB_APPS[@]})); then
    if command -v rofi &>/dev/null; then
      APP_NAME=$(printf '%s\n' "${SORTED_WEB_APPS[@]}" | rofi -dmenu -prompt "Select web app to remove")
    elif command -v gum &>/dev/null; then
      APP_NAME=$(gum choose "${SORTED_WEB_APPS[@]}" --header "Select web app to remove")
    else
      echo "No interactive picker found (need rofi or gum). Web apps:"
      printf '%s\n' "${SORTED_WEB_APPS[@]}"
      exit 1
    fi
  else
    echo "No web apps to remove."
    exit 1
  fi
else
  APP_NAME="$*"
fi

if [[ -z $APP_NAME ]]; then
  echo "You must select a web app to remove."
  exit 1
fi

icon_name=$(printf '%s\n' "$APP_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')

FILES=("$DESKTOP_DIR/$APP_NAME.desktop" "$ICON_DIR/$icon_name.png" "$ICON_DIR/$APP_NAME.png" "$OLD_ICON_DIR/$APP_NAME.png")
EXISTING=()
for f in "${FILES[@]}"; do
  [[ -e $f ]] && EXISTING+=("$f")
done

if (( ${#EXISTING[@]} == 0 )); then
  echo "Nothing to remove for $APP_NAME."
  exit 1
fi

if [[ $DRY == "true" ]]; then
  for f in "${EXISTING[@]}"; do
    echo "Would remove: $f"
  done
  exit 0
fi

for f in "${EXISTING[@]}"; do
  rm -f "$f"
  echo "Removing: $f"
done
update-desktop-database "$DESKTOP_DIR" &>/dev/null