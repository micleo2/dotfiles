#!/bin/bash

# Launch a URL as a web app (--app mode, chromeless window) in the default
# Chromium-based browser, scoped under Uwsm.
# Usage: webapp-launch <url> [browser flags...]

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: webapp-launch <url> [browser flags...]"
  echo "Launch a URL as a web app (--app mode, chromeless window) in the default"
  echo "Chromium-based browser, scoped under Uwsm."
  exit 0
fi

browser=$(xdg-settings get default-web-browser)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

exec setsid uwsm-app -- $(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,/usr}/share/applications/$browser 2>/dev/null | head -1) --app="$1" "${@:2}"