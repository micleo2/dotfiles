#!/usr/bin/env python3
"""Launch an app, or focus the existing window if one matches.

The window is matched on exactly one field:
  (default)  match WM_CLASS
  --title    match the window title
No cross-field fallback. If no window matches, the command is run.

Usage: app-launch-or-focus [--class|--title] <pattern> <command...>
"""

import argparse
import json
import os
import re
import subprocess


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="app-launch-or-focus",
        description="Focus the existing window matching <pattern>, or run <command...>.",
    )
    parser.add_argument("--class", dest="by_class", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--title", dest="by_title", action="store_true", help="match the window title instead of WM_CLASS")
    parser.add_argument(
        "rest",
        nargs=argparse.REMAINDER,
        metavar="ARG",
        help="<pattern> followed by <command...> to run when no window matches",
    )
    args = parser.parse_args()

    if len(args.rest) < 2:
        parser.print_help()
        return 1

    field = "title" if args.by_title else "class"
    pattern, *command = args.rest
    rx = re.compile(r"\b" + pattern + r"\b", re.IGNORECASE)

    clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"], text=True))
    matches = [c for c in clients if rx.search(c.get(field) or "")]

    if not matches:
        os.execvp(command[0], command)

    # Hyprland >= 0.55 parses `hyprctl dispatch` args as a Lua expression.
    subprocess.run(
        ["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{matches[0]["address"]}" }})'],
        check=True,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())