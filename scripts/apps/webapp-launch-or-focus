#!/bin/bash

# Launch a web app, or focus the existing window if one matches.
# Single-instance: an existing window whose class or title matches the pattern
# is focused instead of launching a duplicate (--app sets the window title to
# the site name, so matching on the app Name hits the title).
# Usage: webapp-launch-or-focus <window-pattern> <url-and-flags...>

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: webapp-launch-or-focus <window-pattern> <url-and-flags...>"
  echo "Focus an existing window whose class or title matches the pattern, otherwise"
  echo "launch the URL as a web app (see webapp-launch)."
  exit 0
fi

if (($# == 0)); then
  echo "Usage: webapp-launch-or-focus <window-pattern> <url-and-flags...>"
  exit 1
fi

WINDOW_PATTERN="$1"
shift

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg p "$WINDOW_PATTERN" '.[]|select((.class|test("\\b"+$p+"\\b";"i")) or (.title|test("\\b"+$p+"\\b";"i")))|.address' | head -n1)

if [[ -n $WINDOW_ADDRESS ]]; then
  # Hyprland >= 0.55 parses `hyprctl dispatch` args as a Lua expression.
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$WINDOW_ADDRESS\" })"
else
  # Absolute path: Hyprland's service PATH has no ~/.local/bin.
  exec "$SCRIPT_DIR/webapp-launch" "$@"
fi