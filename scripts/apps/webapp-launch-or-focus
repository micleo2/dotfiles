#!/usr/bin/env python3
"""Launch a web app, or focus the existing window if one matches.

Single-instance: a window whose class matches the URL's host is focused
instead of launching a duplicate. Chromium --app mode ignores --class and
forces the window class to chrome-<host>__<path>-<profile>, so matching is
done on that prefix, which is stable across paths and profiles.

Usage: webapp-launch-or-focus <name> <url> [chromium flags...]
"""

import argparse
import json
import os
import re
import subprocess
from urllib.parse import urlparse


def host_class_prefix(url: str) -> str:
    """Regex matching any chromium --app window launched from this URL's host."""
    host = urlparse(url).netloc.split(":")[0].lower()
    return rf"^(?:chrome|chromium)-{re.escape(host)}__"


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="webapp-launch-or-focus",
        description="Focus the existing web app window for <url>, or launch it with webapp-launch.",
    )
    parser.add_argument("name", help="app name (kept for compatibility; matching is by URL host)")
    parser.add_argument("url", help="URL the app window was, or will be, launched with")
    parser.add_argument("rest", nargs="*", metavar="ARG", help="extra chromium flags passed to webapp-launch")
    args = parser.parse_args()

    pattern = re.compile(host_class_prefix(args.url), re.IGNORECASE)
    clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"], text=True))
    matches = [c for c in clients if pattern.match(c.get("class") or "")]

    if matches:
        target = max(matches, key=lambda c: c.get("focusHistoryID", 0))
        # Hyprland >= 0.55 parses `hyprctl dispatch` args as a Lua expression.
        subprocess.run(
            ["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{target["address"]}" }})'],
            check=True,
        )
        return 0

    os.execvp("webapp-launch", ["webapp-launch", args.url, *args.rest])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())