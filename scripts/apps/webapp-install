#!/usr/bin/env python3
"""Create a desktop launcher for a web app.

Usage: webapp-install [--singleton=1|0] <name> <url> [icon-url-or-name [custom-exec] [mime-types]]
Create a desktop launcher (and icon) for a web app.
Icons can be found at https://dashboardicons.com/
With fewer than 2 positional arguments, runs an interactive wizard (requires gum).
  --singleton=1|0  Use webapp-launch-or-focus (1, default) or webapp-launch (0) in Exec.

The launcher writes StartupWMClass with the WM_CLASS chromium forces in --app
mode (chrome-<host>__<path>-<profile>), so the window resolves back to this
desktop entry (name + icon) in the quickshell top bar.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
from urllib.parse import urlparse

ICON_DIR = os.path.expanduser("~/.local/share/icons/hicolor/256x256/apps")
ICON_THEME = os.path.expanduser("~/.local/share/icons/hicolor")
APPS_DIR = os.path.expanduser("~/.local/share/applications")


def safe_name(name: str) -> str:
    return re.sub(r"^-+|-+$", "", re.sub(r"[^a-z0-9]+", "-", name.lower()))


def chromium_app_class(url: str, profile: str = "Default") -> str:
    """The WM_CLASS chromium forces on a --app window (the Wayland app-id).

    chrome-<host>__<path>-<profile>: path without leading slash, '/' -> '_',
    fragment dropped; an empty path leaves a bare '__-'.
    """
    parsed = urlparse(url)
    host = parsed.netloc.split(":")[0]
    path = parsed.path.lstrip("/").replace("/", "_")
    if path:
        return f"chrome-{host}__{path}-{profile}"
    return f"chrome-{host}__-{profile}"


def die(msg: str) -> None:
    print(msg)
    sys.exit(1)


def run(cmd: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, **kwargs)


def refresh_icon_cache() -> None:
    run(["gtk-update-icon-cache", ICON_THEME])


def gum_input(prompt: str, placeholder: str) -> str:
    result = subprocess.run(
        ["gum", "input", "--prompt", prompt, "--placeholder", placeholder],
        capture_output=True,
        text=True,
        check=False,
    )
    return result.stdout.strip()


def png_size(path: str) -> tuple[int, int] | None:
    try:
        with open(path, "rb") as f:
            data = f.read(24)
        if data[:8] != b"\x89PNG\r\n\x1a\n" or data[12:16] != b"IHDR":
            return None
        return int.from_bytes(data[16:20], "big"), int.from_bytes(data[20:24], "big")
    except OSError:
        return None


def download_icon(url: str, dest: str) -> bool:
    run(["curl", "-fsSL", "--max-time", "10", "-o", dest, url])
    if not os.path.isfile(dest) or os.path.getsize(dest) == 0:
        if os.path.exists(dest):
            os.remove(dest)
        return False
    mime = subprocess.run(["file", "-b", "--mime-type", dest], capture_output=True, text=True).stdout.strip()
    if mime != "image/png":
        os.remove(dest)
        return False
    size = png_size(dest)
    if size is None or min(size) < 128:
        # Reject tiny favicons; the icon dir is 256x256.
        os.remove(dest)
        return False
    return True


def resolve_relative(url: str, origin: str) -> str:
    if re.match(r"^https?://", url):
        return url
    if url.startswith("//"):
        return "https:" + url
    if url.startswith("/"):
        return origin + url
    if url.startswith("?"):
        return origin + "/" + url
    return ""


def fetch_site_icon(site_url: str, dest: str) -> bool:
    """Prefer the site's own high-res icon (apple-touch-icon is typically 180px+),
    then the well-known path, then Google's favicon service as a last resort."""
    parsed = urlparse(site_url)
    origin = f"{parsed.scheme}://{parsed.netloc}"

    page = subprocess.run(
        ["curl", "-fsSL", "--max-time", "5", site_url], capture_output=True, text=True, check=False
    ).stdout[:100000]
    link = re.search(r"<link[^>]*rel=[\"'][^\"']*apple-touch-icon[^\"']*[\"'][^>]*>", page, re.IGNORECASE)
    icon_url = ""
    if link:
        href = re.search(r"href=[\"']([^\"']+)", link.group(0))
        if href:
            icon_url = resolve_relative(href.group(1).strip(), origin)

    # Strip any fragment: inside the s2 URL a "#" would swallow "&sz=256" and
    # curl would drop it, silently requesting the default tiny favicon.
    domain = site_url.split("#")[0]
    candidates = [c for c in (icon_url, f"{origin}/apple-touch-icon.png") if c]
    candidates.append(f"https://www.google.com/s2/favicons?domain={domain}&sz=256")
    for candidate in candidates:
        if download_icon(candidate, dest):
            return True
    return False


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="webapp-install",
        description="Create a desktop launcher (and icon) for a web app.",
    )
    parser.add_argument(
        "--singleton",
        choices=("0", "1"),
        default="1",
        help="use webapp-launch-or-focus (1, default) or webapp-launch (0) in Exec",
    )
    parser.add_argument("name", nargs="?", help="app name")
    parser.add_argument("url", nargs="?", help="app URL")
    parser.add_argument("icon_ref", nargs="?", help="icon URL, icon file path, or icon theme name")
    parser.add_argument("custom_exec", nargs="?", help="custom Exec command (overrides the default)")
    parser.add_argument("mime_types", nargs="?", help="MimeType= value (optional)")
    args = parser.parse_args()

    interactive = False
    custom_exec = ""
    mime_types = ""
    icon_ref = ""
    if args.name is None or args.url is None:
        print("\x1b[32mLet's create a new web app you can start with the app launcher.\n\x1b[0m")
        app_name = gum_input("Name> ", "My favorite web app")
        app_url = gum_input("URL> ", "https://example.com")
        if not re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*:", app_url):
            app_url = "https://" + app_url

        # Try to fetch the site's icon automatically first.
        os.makedirs(ICON_DIR, exist_ok=True)
        icon_value = safe_name(app_name)
        if fetch_site_icon(app_url, f"{ICON_DIR}/{icon_value}.png"):
            refresh_icon_cache()
            icon_ref = icon_value
        else:
            icon_ref = gum_input(
                "Icon URL/name> ", "Could not fetch favicon automatically. Enter PNG icon URL or icon name"
            )
        interactive = True
    else:
        app_name = args.name
        app_url = args.url
        if not re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*:", app_url):
            app_url = "https://" + app_url
        icon_ref = args.icon_ref or ""
        custom_exec = args.custom_exec or ""
        mime_types = args.mime_types or ""

    if not app_name or not app_url:
        die("You must set app name and app URL!")

    created = []
    if not icon_ref:
        icon_value = safe_name(app_name)
        os.makedirs(ICON_DIR, exist_ok=True)
        if not fetch_site_icon(app_url, f"{ICON_DIR}/{icon_value}.png"):
            die("Error: Failed to download icon.")
        created.append(f"{ICON_DIR}/{icon_value}.png")
        refresh_icon_cache()
    elif re.match(r"^https?://", icon_ref):
        icon_value = safe_name(app_name)
        os.makedirs(ICON_DIR, exist_ok=True)
        if not download_icon(icon_ref, f"{ICON_DIR}/{icon_value}.png"):
            die("Error: Failed to download icon.")
        created.append(f"{ICON_DIR}/{icon_value}.png")
        refresh_icon_cache()
    elif os.path.isfile(icon_ref):
        icon_value = safe_name(app_name)
        ext = os.path.splitext(icon_ref)[1] or ".png"
        os.makedirs(ICON_DIR, exist_ok=True)
        shutil.copy(icon_ref, f"{ICON_DIR}/{icon_value}{ext}")
        created.append(f"{ICON_DIR}/{icon_value}{ext}")
        refresh_icon_cache()
    else:
        # Icon name, resolved from the icon theme (accepts "name" or "name.png").
        base = os.path.basename(icon_ref)
        icon_value = safe_name(base[: base.rfind(".")]) if "." in base else base

    # Use custom exec if provided, otherwise default behavior.
    if args.singleton == "1":
        default_exec = f"webapp-launch-or-focus {app_name} {app_url}"
    else:
        default_exec = f"webapp-launch {app_url}"
    exec_command = custom_exec or default_exec

    # Create application .desktop file. StartupWMClass is the forced --app
    # window class, so the window resolves to this entry (name + icon).
    desktop_file = f"{APPS_DIR}/{app_name}.desktop"
    os.makedirs(APPS_DIR, exist_ok=True)
    with open(desktop_file, "w") as f:
        f.write(
            f"""[Desktop Entry]
Version=1.0
Name={app_name}
Comment={app_name}
Exec={exec_command}
Terminal=false
Type=Application
Icon={icon_value}
StartupWMClass={chromium_app_class(app_url)}
StartupNotify=true
"""
        )
        if mime_types:
            f.write(f"MimeType={mime_types}\n")
    os.chmod(desktop_file, 0o755)
    run(["update-desktop-database", APPS_DIR])

    created.append(desktop_file)
    for path in created:
        print(f"Created: {path}")

    if interactive:
        print(f"You can now find {app_name} using the app launcher (SUPER + SPACE)\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())