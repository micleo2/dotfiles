#!/usr/bin/env bash
# retro-launcher: `rofi -dmenu` for the quickshell retro shell. Lines on
# stdin, the chosen line on stdout, exit 1 when nothing was chosen.
#
#   -p, --prompt TEXT   label on the module's header
set -u

prompt=""
while [ $# -gt 0 ]; do
  case $1 in
    -p | --prompt)
      prompt=${2-}
      shift
      ;;
    -h | --help)
      sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
  esac
  shift
done

dir=$(mktemp -d -t retro-launcher.XXXXXX) || exit 1
trap 'rm -rf "$dir"' EXIT

cat >"$dir/items"
mkfifo "$dir/out" || exit 1

qs -c retro ipc call launcher dmenu "$dir" "$prompt" >/dev/null || exit 1

# Read-write, so the open never blocks and a dead shell hits the timeout.
exec 3<>"$dir/out"
IFS= read -r -t 600 -u 3 sel || exit 1
[ -n "$sel" ] || exit 1
printf '%s\n' "$sel"
